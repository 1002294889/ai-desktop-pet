{
  "id": "rae-red-panda",
  "name": "Rae Red Panda Companion",
  "renderer": "3d",
  "version": 1,
  "defaultWidth": 260,
  "defaultHeight": 280,
  "scale": 0.92,
  "preview": "preview.svg",
  "model": "assets/rae-red-panda.glb",
  "3d": {
    "source": "model",
    "cameraPosition": [0, 0.15, 8],
    "modelPosition": [0.22, -1.42, 0],
    "modelRotation": [0, 0, 0],
    "rootMotion": "lock-horizontal",
    "lookAt": {
      "headBone": "Head"
    }
  },
  "actions": {
    "idle": {
      "type": "3d",
      "clip": "Idle",
      "loop": true,
      "fadeDurationMs": 180
    },
    "walk_left": {
      "type": "3d",
      "clip": "Walk",
      "loop": true,
      "fadeDurationMs": 160
    },
    "walk_right": {
      "type": "3d",
      "clip": "Walk",
      "loop": true,
      "fadeDurationMs": 160
    },
    "sit": {
      "type": "3d",
      "source": "assets/animations/rae-actions.glb",
      "clip": "RaeSit",
      "loop": true,
      "fadeDurationMs": 300,
      "lookAtWeight": 0.7
    },
    "sleep": {
      "type": "3d",
      "source": "assets/animations/rae-actions.glb",
      "clip": "RaeSleep",
      "loop": true,
      "fadeDurationMs": 420,
      "lookAtWeight": 0
    },
    "wake": {
      "type": "3d",
      "source": "assets/animations/rae-actions.glb",
      "clip": "RaeWake",
      "loop": false,
      "fadeDurationMs": 260,
      "clampWhenFinished": true,
      "lookAtWeight": 0.2
    },
    "happy": {
      "type": "3d",
      "source": "assets/animations/celebrate.glb",
      "clip": "CelebrateT",
      "retarget": {
        "mode": "humanoid",
        "sampleRate": 30,
        "hipTranslation": "scaled",
        "translationScale": "auto",
        "bones": {
          "hips": { "source": "TP_Hips", "target": "Root" },
          "spine": { "source": "TP_Spine", "target": "Hips" },
          "chest": { "source": "TP_Chest", "target": "Torso" },
          "neck": { "source": "TP_Neck", "target": "Neck" },
          "head": { "source": "TP_Head", "target": "Head" },
          "leftShoulder": { "source": "TP_L_Shoulder", "target": "Shoulder.L" },
          "rightShoulder": { "source": "TP_R_Shoulder", "target": "Shoulder.R" },
          "leftUpperArm": { "source": "TP_L_UpperArm", "target": "UpperArm.L" },
          "rightUpperArm": { "source": "TP_R_UpperArm", "target": "UpperArm.R" },
          "leftLowerArm": { "source": "TP_L_LowerArm", "target": "LowerArm.L" },
          "rightLowerArm": { "source": "TP_R_LowerArm", "target": "LowerArm.R" },
          "leftUpperLeg": { "source": "TP_L_Thigh", "target": "UpperLeg.L" },
          "rightUpperLeg": { "source": "TP_R_Thigh", "target": "UpperLeg.R" },
          "leftLowerLeg": { "source": "TP_L_Shin", "target": "LowerLeg.L" },
          "rightLowerLeg": { "source": "TP_R_Shin", "target": "LowerLeg.R" },
          "leftFoot": { "source": "TP_L_Foot", "target": "Foot.L" },
          "rightFoot": { "source": "TP_R_Foot", "target": "Foot.R" }
        }
      },
      "loop": false,
      "fadeDurationMs": 180,
      "clampWhenFinished": true,
      "lookAtWeight": 0
    },
    "angry": {
      "type": "3d",
      "clip": "No",
      "loop": false,
      "fadeDurationMs": 150,
      "clampWhenFinished": true,
      "lookAtWeight": 0.35
    },
    "jump": {
      "type": "3d",
      "source": "assets/animations/rae-actions.glb",
      "clip": "RaeJump",
      "loop": false,
      "fadeDurationMs": 160,
      "clampWhenFinished": true,
      "lookAtWeight": 0.18
    },
    "wave": {
      "type": "3d",
      "clip": "Wave",
      "loop": false,
      "fadeDurationMs": 200,
      "clampWhenFinished": true
    },
    "talk": {
      "type": "3d",
      "clip": "Yes",
      "loop": false,
      "fadeDurationMs": 120,
      "clampWhenFinished": true
    },
    "dragged": {
      "type": "3d",
      "loop": false,
      "durationMs": 900,
      "lookAtWeight": 0
    },
    "dance_01": {
      "type": "3d",
      "source": "assets/animations/groove-a-pose.glb",
      "clip": "GrooveA",
      "retarget": {
        "mode": "humanoid",
        "sampleRate": 30,
        "hipTranslation": "scaled",
        "translationScale": "auto",
        "bones": {
          "hips": { "source": "AP_Pelvis", "target": "Root" },
          "spine": { "source": "AP_Lumbar", "target": "Hips" },
          "chest": { "source": "AP_Thorax", "target": "Torso" },
          "neck": { "source": "AP_NeckJoint", "target": "Neck" },
          "head": { "source": "AP_HeadJoint", "target": "Head" },
          "leftShoulder": { "source": "AP_LeftClavicle", "target": "Shoulder.L" },
          "rightShoulder": { "source": "AP_RightClavicle", "target": "Shoulder.R" },
          "leftUpperArm": { "source": "AP_LeftUpperArm", "target": "UpperArm.L" },
          "rightUpperArm": { "source": "AP_RightUpperArm", "target": "UpperArm.R" },
          "leftLowerArm": { "source": "AP_LeftForearm", "target": "LowerArm.L" },
          "rightLowerArm": { "source": "AP_RightForearm", "target": "LowerArm.R" },
          "leftUpperLeg": { "source": "AP_LeftThigh", "target": "UpperLeg.L" },
          "rightUpperLeg": { "source": "AP_RightThigh", "target": "UpperLeg.R" },
          "leftLowerLeg": { "source": "AP_LeftCalf", "target": "LowerLeg.L" },
          "rightLowerLeg": { "source": "AP_RightCalf", "target": "LowerLeg.R" },
          "leftFoot": { "source": "AP_LeftAnkle", "target": "Foot.L" },
          "rightFoot": { "source": "AP_RightAnkle", "target": "Foot.R" }
        }
      },
      "loop": false,
      "fadeDurationMs": 180,
      "clampWhenFinished": true,
      "lookAtWeight": 0
    }
  }
}
