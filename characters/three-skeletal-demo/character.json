{
  "id": "three-skeletal-demo",
  "name": "Rigged 3D Test Pet",
  "renderer": "3d",
  "version": 1,
  "defaultWidth": 250,
  "defaultHeight": 270,
  "scale": 0.86,
  "preview": "preview.svg",
  "model": "assets/rigged-demo.glb",
  "3d": {
    "source": "model",
    "cameraPosition": [0, 0.45, 5.8],
    "modelPosition": [0, -1.35, 0],
    "modelRotation": [0, 0, 0],
    "rootMotion": "lock-horizontal",
    "lookAt": {
      "headBone": "Head",
      "leftEyeBone": "LeftEye",
      "rightEyeBone": "RightEye"
    }
  },
  "actions": {
    "idle": { "type": "3d", "clip": "Idle", "loop": true, "fadeDurationMs": 180 },
    "walk_left": { "type": "3d", "clip": "Walk", "loop": true, "fadeDurationMs": 160 },
    "walk_right": { "type": "3d", "clip": "Walk", "loop": true, "fadeDurationMs": 160 },
    "sit": { "type": "3d", "clip": "Sit", "loop": true, "fadeDurationMs": 200 },
    "sleep": { "type": "3d", "clip": "Sleep", "loop": true, "fadeDurationMs": 260 },
    "wake": { "type": "3d", "clip": "Wake", "loop": false, "fadeDurationMs": 220, "clampWhenFinished": true },
    "happy": { "type": "3d", "clip": "Happy", "loop": false, "fadeDurationMs": 140, "clampWhenFinished": true },
    "angry": { "type": "3d", "clip": "Angry", "loop": false, "fadeDurationMs": 120, "clampWhenFinished": true },
    "jump": { "type": "3d", "clip": "Jump", "loop": false, "fadeDurationMs": 100, "clampWhenFinished": true },
    "wave": { "type": "3d", "clip": "Wave", "loop": false, "fadeDurationMs": 140, "clampWhenFinished": true },
    "talk": { "type": "3d", "clip": "Talk", "loop": false, "fadeDurationMs": 100, "clampWhenFinished": true },
    "dragged": { "type": "3d", "loop": false, "durationMs": 900 }
  }
}
