{
  "id": "three-skeletal-demo",
  "name": "Rigged 3D Test Pet",
  "renderer": "3d",
  "version": 3,
  "defaultWidth": 250,
  "defaultHeight": 270,
  "scale": 0.86,
  "preview": "preview.svg",
  "model": "assets/rigged-demo.glb",
  "3d": {
    "source": "model",
    "cameraPosition": [0, 0.45, 5.8],
    "modelPosition": [0, -1.35, 0],
    "modelRotation": [0, 0, 0],
    "rootMotion": "lock-horizontal",
    "lookAt": {
      "headBone": "Head",
      "leftEyeBone": "LeftEye",
      "rightEyeBone": "RightEye"
    }
  },
  "actions": {
    "idle": { "type": "3d", "clip": "Idle", "loop": true, "fadeDurationMs": 180 },
    "walk_left": { "type": "3d", "clip": "Walk", "loop": true, "fadeDurationMs": 160 },
    "walk_right": { "type": "3d", "clip": "Walk", "loop": true, "fadeDurationMs": 160 },
    "sit": { "type": "3d", "clip": "Sit", "loop": true, "fadeDurationMs": 260 },
    "sleep": { "type": "3d", "clip": "Sleep", "loop": true, "fadeDurationMs": 340 },
    "wake": { "type": "3d", "clip": "Wake", "loop": false, "fadeDurationMs": 220, "clampWhenFinished": true },
    "happy": {
      "type": "3d",
      "source": "assets/animations/celebrate.glb",
      "clip": "CelebrateT",
      "retarget": {
        "mode": "humanoid",
        "sampleRate": 30,
        "hipTranslation": "scaled",
        "translationScale": "auto",
        "bones": {
          "hips": { "source": "TP_Hips", "target": "RigRoot" },
          "spine": { "source": "TP_Spine", "target": "Body" },
          "chest": { "source": "TP_Chest", "target": "Chest" },
          "neck": { "source": "TP_Neck", "target": "Neck" },
          "head": { "source": "TP_Head", "target": "Head" },
          "leftShoulder": { "source": "TP_L_Shoulder", "target": "LeftShoulder" },
          "rightShoulder": { "source": "TP_R_Shoulder", "target": "RightShoulder" },
          "leftUpperArm": { "source": "TP_L_UpperArm", "target": "LeftArm" },
          "rightUpperArm": { "source": "TP_R_UpperArm", "target": "RightArm" },
          "leftLowerArm": { "source": "TP_L_LowerArm", "target": "LeftForeArm" },
          "rightLowerArm": { "source": "TP_R_LowerArm", "target": "RightForeArm" },
          "leftHand": { "source": "TP_L_Hand", "target": "LeftHand" },
          "rightHand": { "source": "TP_R_Hand", "target": "RightHand" },
          "leftUpperLeg": { "source": "TP_L_Thigh", "target": "LeftLeg" },
          "rightUpperLeg": { "source": "TP_R_Thigh", "target": "RightLeg" },
          "leftLowerLeg": { "source": "TP_L_Shin", "target": "LeftShin" },
          "rightLowerLeg": { "source": "TP_R_Shin", "target": "RightShin" },
          "leftFoot": { "source": "TP_L_Foot", "target": "LeftFoot" },
          "rightFoot": { "source": "TP_R_Foot", "target": "RightFoot" }
        }
      },
      "loop": false,
      "fadeDurationMs": 160,
      "clampWhenFinished": true,
      "lookAtWeight": 0
    },
    "angry": {
      "type": "3d",
      "source": "assets/animations/groove-a-pose.glb",
      "clip": "GrooveA",
      "retarget": {
        "mode": "humanoid",
        "sampleRate": 30,
        "hipTranslation": "scaled",
        "translationScale": "auto",
        "bones": {
          "hips": { "source": "AP_Pelvis", "target": "RigRoot" },
          "spine": { "source": "AP_Lumbar", "target": "Body" },
          "chest": { "source": "AP_Thorax", "target": "Chest" },
          "neck": { "source": "AP_NeckJoint", "target": "Neck" },
          "head": { "source": "AP_HeadJoint", "target": "Head" },
          "leftShoulder": { "source": "AP_LeftClavicle", "target": "LeftShoulder" },
          "rightShoulder": { "source": "AP_RightClavicle", "target": "RightShoulder" },
          "leftUpperArm": { "source": "AP_LeftUpperArm", "target": "LeftArm" },
          "rightUpperArm": { "source": "AP_RightUpperArm", "target": "RightArm" },
          "leftLowerArm": { "source": "AP_LeftForearm", "target": "LeftForeArm" },
          "rightLowerArm": { "source": "AP_RightForearm", "target": "RightForeArm" },
          "leftHand": { "source": "AP_LeftPalm", "target": "LeftHand" },
          "rightHand": { "source": "AP_RightPalm", "target": "RightHand" },
          "leftUpperLeg": { "source": "AP_LeftThigh", "target": "LeftLeg" },
          "rightUpperLeg": { "source": "AP_RightThigh", "target": "RightLeg" },
          "leftLowerLeg": { "source": "AP_LeftCalf", "target": "LeftShin" },
          "rightLowerLeg": { "source": "AP_RightCalf", "target": "RightShin" },
          "leftFoot": { "source": "AP_LeftAnkle", "target": "LeftFoot" },
          "rightFoot": { "source": "AP_RightAnkle", "target": "RightFoot" }
        }
      },
      "loop": false,
      "fadeDurationMs": 160,
      "clampWhenFinished": true,
      "lookAtWeight": 0
    },
    "jump": { "type": "3d", "clip": "Jump", "loop": false, "fadeDurationMs": 150, "clampWhenFinished": true },
    "wave": { "type": "3d", "clip": "Wave", "loop": false, "fadeDurationMs": 200, "clampWhenFinished": true },
    "talk": { "type": "3d", "clip": "Talk", "loop": false, "fadeDurationMs": 100, "clampWhenFinished": true },
    "dragged": { "type": "3d", "loop": false, "durationMs": 900 },
    "dance_01": {
      "type": "3d",
      "source": "assets/animations/groove-a-pose.glb",
      "clip": "GrooveA",
      "retarget": {
        "mode": "humanoid",
        "sampleRate": 30,
        "hipTranslation": "scaled",
        "translationScale": "auto",
        "bones": {
          "hips": { "source": "AP_Pelvis", "target": "RigRoot" },
          "spine": { "source": "AP_Lumbar", "target": "Body" },
          "chest": { "source": "AP_Thorax", "target": "Chest" },
          "neck": { "source": "AP_NeckJoint", "target": "Neck" },
          "head": { "source": "AP_HeadJoint", "target": "Head" },
          "leftShoulder": { "source": "AP_LeftClavicle", "target": "LeftShoulder" },
          "rightShoulder": { "source": "AP_RightClavicle", "target": "RightShoulder" },
          "leftUpperArm": { "source": "AP_LeftUpperArm", "target": "LeftArm" },
          "rightUpperArm": { "source": "AP_RightUpperArm", "target": "RightArm" },
          "leftLowerArm": { "source": "AP_LeftForearm", "target": "LeftForeArm" },
          "rightLowerArm": { "source": "AP_RightForearm", "target": "RightForeArm" },
          "leftHand": { "source": "AP_LeftPalm", "target": "LeftHand" },
          "rightHand": { "source": "AP_RightPalm", "target": "RightHand" },
          "leftUpperLeg": { "source": "AP_LeftThigh", "target": "LeftLeg" },
          "rightUpperLeg": { "source": "AP_RightThigh", "target": "RightLeg" },
          "leftLowerLeg": { "source": "AP_LeftCalf", "target": "LeftShin" },
          "rightLowerLeg": { "source": "AP_RightCalf", "target": "RightShin" },
          "leftFoot": { "source": "AP_LeftAnkle", "target": "LeftFoot" },
          "rightFoot": { "source": "AP_RightAnkle", "target": "RightFoot" }
        }
      },
      "loop": false,
      "fadeDurationMs": 160,
      "clampWhenFinished": true,
      "lookAtWeight": 0
    }
  }
}
