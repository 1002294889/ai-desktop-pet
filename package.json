{
  "name": "ai-desktop-pet",
  "version": "1.0.0",
  "description": "AI desktop pet with replaceable characters, natural chat, local memory, and native desktop controls",
  "main": "./out/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "package": "npm run build && electron-builder --dir --config.electronDist=node_modules/electron/dist",
    "package:mac": "npm run build && electron-builder --mac dir --arm64 --config.electronDist=node_modules/electron/dist",
    "dist": "npm run build && electron-builder --config.electronDist=node_modules/electron/dist",
    "dist:mac": "npm run build && electron-builder --mac dmg --arm64 --config.electronDist=node_modules/electron/dist",
    "dist:mac:x64": "npm run build && electron-builder --mac dmg --x64",
    "dist:win": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }
}
